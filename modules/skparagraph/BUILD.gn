import("../../gn/skia.gni")
import("../skshaper/skshaper.gni")
import("../skunicode/skunicode.gni")
import("skparagraph.gni")

declare_args() {
  skia_enable_skparagraph = true
  paragraph_gms_enabled = true
  paragraph_tests_enabled = true
  paragraph_bench_enabled = true
  skia_use_coretext_paragraph = skia_use_fonthost_mac
}

if (skia_enable_skparagraph && skia_enable_skshaper && skia_enable_skunicode &&
    (skia_use_harfbuzz || skia_use_coretext_paragraph)) {
  config("public_config") {
    defines = [ "SK_ENABLE_PARAGRAPH" ]
    if (skia_use_coretext_paragraph) {
      defines += [ "SK_PARAGRAPH_NATIVE_CORETEXT" ]
    }
    if (!skia_use_harfbuzz) {
      defines += [ "SK_PARAGRAPH_DISABLE_HARFBUZZ" ]
    }
    include_dirs = [
      "include",
      "utils",
    ]
  }

  skia_component("skparagraph") {
    import("skparagraph.gni")
    public_configs = [ ":public_config" ]
    public = skparagraph_core_public
    sources = skparagraph_core_sources
    if (skia_use_coretext_paragraph) {
      sources += skparagraph_coretext_sources
      frameworks = [
        "CoreFoundation.framework",
        "CoreGraphics.framework",
        "CoreText.framework",
      ]
    }
    if (!skia_use_harfbuzz) {
      # OneLineShaper is the HarfBuzz shaper; CoreText-only builds lay out kCoreText alone
      sources -= [
        "//modules/skparagraph/src/OneLineShaper.cpp",
        "//modules/skparagraph/src/OneLineShaper.h",
      ]
    }
    public_deps = [
      "../..:skia",
      "../skunicode",
    ]
    deps = [ "../skshaper" ]
  }

  config("utils_config") {
    include_dirs = [ "utils" ]
  }

  if (defined(is_skia_standalone) && skia_enable_tools) {
    import("skparagraph.gni")
    skia_source_set("utils") {
      public_configs = [ ":utils_config" ]
      configs = [ "../../:skia_private" ]
      sources = skparagraph_utils
      deps = [
        "../..:skia",
        "../skshaper",
      ]
    }

    skia_source_set("gm") {
      # Paragraph GMs lay out kDefault paragraphs, which abort when HarfBuzz is disabled
      if (paragraph_gms_enabled && skia_use_harfbuzz &&
          (skia_use_icu || skia_use_libgrapheme || skia_use_icu4x)) {
        testonly = true
        sources = [
          "gm/ellipsis_bidi_gm.cpp",
          "gm/simple_gm.cpp",
          "gm/softhyphen_gm.cpp",
        ]
        deps = [
          ":skparagraph",
          "../..:skia",
          "../skshaper",
          "../skunicode",
        ]
      } else {
        sources = []
      }
    }

    if (skia_enable_tools) {
      skia_source_set("tests") {
        if (paragraph_tests_enabled &&
            (skia_use_icu || skia_use_libgrapheme || skia_use_icu4x ||
             skia_use_apple_unicode)) {
          testonly = true
          sources = skparagraph_tests
          if (skia_use_coretext_paragraph &&
              (skia_use_apple_unicode || skia_use_icu)) {
            sources += skparagraph_coretext_tests
          }
          if (!skia_use_harfbuzz ||
              !(skia_use_icu || skia_use_libgrapheme || skia_use_icu4x)) {
            # SkParagraphTest lays out kDefault paragraphs with ICU, libgrapheme, or ICU4X
            sources -= [ "//modules/skparagraph/tests/SkParagraphTest.cpp" ]
          }
          deps = [
            ":skparagraph",
            ":utils",
            "../..:skia",
            "../..:test",
            "../skshaper",
            "../skunicode",
          ]
        } else {
          sources = []
        }
      }
    }

    skia_source_set("bench") {
      # ParagraphBench lays out kDefault paragraphs, which abort when HarfBuzz is disabled
      if (paragraph_bench_enabled && skia_use_harfbuzz &&
          (skia_use_icu || skia_use_libgrapheme || skia_use_icu4x)) {
        testonly = true
        sources = [ "bench/ParagraphBench.cpp" ]
        deps = [
          ":skparagraph",
          "../..:skia",
          "../skshaper",
          "../skunicode",
        ]
      } else {
        sources = []
      }
    }

    skia_source_set("slides") {
      # ParagraphSlide and ParagraphBugsSlide compare against kDefault HarfBuzz shaping
      if (skia_use_harfbuzz && (skia_use_icu || skia_use_libgrapheme)) {
        testonly = true
        sources = [ "slides/ParagraphSlide.cpp" ]
        if (skia_use_coretext_paragraph) {
          sources += [ "slides/ParagraphBugsSlide.cpp" ]
        }
        deps = [
          ":skparagraph",
          ":utils",
          "../..:skia",
          "../skshaper",
          "../skunicode",
        ]
      }
    }
  }
} else {
  group("skparagraph") {
  }
  group("utils") {
  }
  group("gm") {
  }
  group("tests") {
  }
  group("bench") {
  }
  group("slides") {
  }
}
